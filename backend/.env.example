PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase PostgreSQL Configuration
# If omitted, backend operates gracefully in zero-config Demo Mode using in-memory state
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vision / AI / Maps API Keys (Optional - fallbacks are provided)
OCR_API_KEY=
AI_API_KEY=
MAPS_API_KEY=
